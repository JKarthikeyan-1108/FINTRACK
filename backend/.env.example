# ─── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Firebase Admin (Firestore + verifying Firebase Auth ID tokens) ───
# Firebase console → Project settings → Service accounts → "Generate new private key".
# Pick ONE of the options below.

# Option A (recommended for local dev): path to the downloaded JSON, relative to backend/
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B (Docker / hosting): the whole JSON on one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Option C: individual values from the JSON
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Emulator (optional, no real project needed): also set FIREBASE_PROJECT_ID and run
#   firebase emulators:start --only auth,firestore
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
