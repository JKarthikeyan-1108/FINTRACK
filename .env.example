# Frontend .env (Vite)
# Copy to .env for local dev, .env.production for production build

# API base URL (leave as /api for same-origin via nginx proxy)
VITE_API_URL=/api

# Firebase web app config — Firebase console → Project settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
